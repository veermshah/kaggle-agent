# Copy to .env (git-ignored) or set in your shell profile. Never commit real tokens.

# Kaggle API token from https://www.kaggle.com/settings/api ("Generate New Token").
# Alternatively run `kaggle auth login`, or save the token to %USERPROFILE%\.kaggle\access_token (~/.kaggle/access_token on macOS/Linux)
KAGGLE_API_TOKEN=

# Optional: relocate workspaces + database (e.g. a fast data drive)
# KAGGLE_AGENT_HOME=D:\kaggle-agent-data     (Windows)
# KAGGLE_AGENT_HOME=/data/kaggle-agent       (macOS/Linux)

# Optional: bearer token for `python main.py serve` (remote agent HTTP API)
# KAGGLE_AGENT_API_TOKEN=

# Optional: direct LLM research agent (agent.type: anthropic)
# ANTHROPIC_API_KEY=
